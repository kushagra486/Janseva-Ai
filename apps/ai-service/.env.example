# Provider order for the LLM gateway; falls back to rules when all fail. Empty = rules only.
LLM_PROVIDERS=groq,ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# "ollama" = BGE-M3 multilingual embeddings; "hash" = no-model fallback.
EMBED_PROVIDER=hash

# Opt-in: send unmasked notice photos to a hosted vision model when Tesseract fails.
ALLOW_VISION_FALLBACK=false

# Supabase. Leave empty for demo mode (in-memory store, X-Demo-Role headers).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000
