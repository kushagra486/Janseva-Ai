# AI service (FastAPI). Server-side only; the browser talks to /api/ai.
AI_SERVICE_URL=http://localhost:8000

# Supabase. Leave empty to run in demo mode (no login, in-memory data, role switcher).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push (npx web-push generate-vapid-keys). The private key goes to the Edge Function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
