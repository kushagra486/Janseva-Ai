# The AI logic (apps/web/lib/ai/) runs as native routes in this same app; AI_SERVICE_URL just
# points server actions back at this app's own /api/ai routes, local or deployed.
AI_SERVICE_URL=http://localhost:3000/api/ai

# Supabase. Leave empty to run in demo mode (no login, in-memory data, role switcher).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret key (Project Settings -> API). Bypasses RLS; used by lib/ai/store.ts and
# lib/ai/auth.ts the same way the old separate ai-service's service key did.
SUPABASE_SERVICE_KEY=

# Groq (https://console.groq.com/keys). Without this, AI features fall back to deterministic
# rules rather than failing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Web push (npx web-push generate-vapid-keys). The private key goes to the Edge Function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
